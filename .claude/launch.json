{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "jupyter",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "--group",
        "notebooks",
        "jupyter",
        "lab",
        "--no-browser",
        "--port=8888",
        "--ServerApp.root_dir=."
      ],
      "port": 8888
    },
    {
      "name": "listen",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "8880", "-d", "demo"],
      "port": 8880
    },
    {
      "name": "pages",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "8881", "-d", "docs/listen"],
      "port": 8881
    }
  ]
}
