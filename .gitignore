data/
artifacts/

# Listening pages: the audio plays straight from the artifacts packs (via
# the demo/artifacts symlink) and the spectrograms rebuild from them with
# scripts/build_demo.py; page code and configs are committed.
demo/**/*.png

# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.venv/
venv/

# Hydra outputs
outputs/
multirun/

# Jupyter
.ipynb_checkpoints/

# OS
.DS_Store

# A2SB fork clone (github.com/zbitouzakaria/diffusion-audio-restoration,
# branch runnable-anywhere); not a submodule -- a tool we shell out to,
# not code we import.
third_party/a2sb/

# The AudioSR venv (pip `audiosr`, built by scripts/audiosr_setup.sh); the
# directory holds nothing but the environment we shell out to.
third_party/audiosr/

# SonicMaster release clone with its venv and checkpoint
# (scripts/sonicmaster_setup.sh); a tool we shell out to.
third_party/sonicmaster/

# A reference clone of Stability-AI/stable-audio-3. The project depends on
# the pinned git dependency in pyproject.toml, not on this checkout.
third_party/stable-audio-3/

# Secrets
.env
